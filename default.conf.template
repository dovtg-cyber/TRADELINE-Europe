server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;
    gzip on;
    gzip_types text/css application/javascript image/svg+xml;
    add_header X-Content-Type-Options nosniff;
    location / { try_files $uri $uri/ /index.html; }
    location ~* \.(css|js|jpg|png)$ { expires 1h; }
}
